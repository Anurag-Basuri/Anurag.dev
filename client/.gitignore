# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.js

# Next.js build output
/.next/
/out/

# Production build files
/build
/dist

# Turborepo cache
.turbo

# Static analysis and linting cache
/.eslintcache
*.tsbuildinfo

# Environment variables
# Never commit local environment variables
.env.local
.env.development.local
.env.test.local
.env.production.local

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
logs
*.log*

# Testing
/coverage

# Editor directories and files
# We want to share some .vscode settings, but not user-specific ones
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea
*.suo
*.user
*.userosscache
*.sln.docstates

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db