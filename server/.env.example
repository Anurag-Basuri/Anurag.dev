# Server
NODE_ENV=development
PORT=4000

# Application queries use this (includes -pooler)
DATABASE_URL="postgres://user:pass@ep-example-pooler.region.neon.tech/neondb?sslmode=require"

# Migrations use this (NO -pooler)
DATABASE_URL_DIRECT="postgres://user:pass@ep-example.region.neon.tech/neondb?sslmode=require"

# JWT Secrets (generate strong random strings for production)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-long-change-this
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# Admin seed credentials (used by npm run db:seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123456
