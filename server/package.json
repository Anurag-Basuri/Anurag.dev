{
	"name": "anurag-portfolio-server",
	"version": "0.1.0",
	"description": "A TypeScript REST API server built with Express for a developer portfolio system.",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "nodemon --exec tsx src/server.ts --watch src -e ts,json",
		"build": "prisma generate && tsc",
		"postinstall": "prisma generate",
		"start": "node dist/server.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:push": "prisma db push",
		"db:reset": "prisma migrate reset",
		"db:seed": "tsx prisma/seed.ts",
		"db:studio": "prisma studio"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"dependencies": {
		"@google/generative-ai": "^0.24.1",
		"@huggingface/inference": "^4.13.15",
		"@langchain/community": "^1.1.25",
		"@langchain/core": "^1.1.36",
		"@langchain/google-genai": "^2.1.26",
		"@langchain/openai": "^1.3.1",
		"@prisma/adapter-pg": "^7.4.2",
		"@prisma/client": "^7.4.2",
		"prisma": "^7.4.2",
		"@types/multer": "^2.1.0",
		"cloudinary": "^2.9.0",
		"cors": "^2.8.6",
		"dotenv": "^17.3.1",
		"express": "^5.2.1",
		"express-rate-limit": "^8.3.1",
		"jsonwebtoken": "^9.0.2",
		"langchain": "^1.2.37",
		"multer": "^2.1.1",
		"pg": "^8.20.0",
		"sanitize-html": "^2.17.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/express-rate-limit": "^5.1.3",
		"@types/jsonwebtoken": "^9.0.6",
		"@types/node": "^22.19.15",
		"@types/pg": "^8.18.0",
		"@types/sanitize-html": "^2.16.1",
		"nodemon": "^3.1.14",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	}
}
