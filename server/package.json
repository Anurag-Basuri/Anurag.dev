{
	"name": "anuragos-backend",
	"version": "0.1.0",
	"description": "A TypeScript-based REST API server built on Fastify for a developer portfolio system.",
	"private": true,
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsc",
		"start": "node dist/server.js",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:push": "prisma db push",
		"db:reset": "prisma migrate reset",
		"db:seed": "tsx prisma/seed.ts",
		"db:studio": "prisma studio"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"dependencies": {
		"@prisma/client": "^6.19.2",
		"bcrypt": "^6.0.0",
		"cors": "^2.8.6",
		"dotenv": "^17.3.1",
		"express": "^5.2.1",
		"jsonwebtoken": "^9.0.2",
		"sanitize-html": "^2.17.1",
		"zod": "^3.25.76"
	},
	"devDependencies": {
		"@types/bcrypt": "^6.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.6",
		"@types/node": "^22.19.15",
		"@types/sanitize-html": "^2.16.1",
		"prisma": "^6.19.2",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	}
}
