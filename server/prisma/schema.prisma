// Prisma schema for AnuragOS Backend
// Database: NeonDB (Serverless PostgreSQL)

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma-client"
}

datasource db {
  provider  = "postgresql"
}

// ─── Profile (singleton — one row, id is always "main") ──────────

model Profile {
  id            String  @id @default("main") // Sentinel — enforces single row at DB level

  // ─── Identity ────────────────────────────────────────────────
  name          String @default("Anurag Basuri")           // Full name
  pronouns      String?           // e.g. "he/him"
  email         String?           // Public contact email (shown on portfolio)
  phone         String?           // Optional public phone number

  // ─── Headline ────────────────────────────────────────────────
  role          String?           // Primary title e.g. "Full Stack Developer"
  tagline       String?           // Short punchy line for hero section
  summary       String? @db.Text  // 2-3 paragraph professional summary (rich text)
  bio           String? @db.Text  // Casual personal bio for about section

  // ─── Location & Availability ─────────────────────────────────
  location      String?           // e.g. "Bangalore, India"
  timezone      String?           // e.g. "Asia/Kolkata" — shown to recruiters
  openToWork    Boolean @default(false) // Toggle "Open to Work" badge
  availableFrom String?           // e.g. "Immediately" or "June 2025"
  noticePeriod  String?           // e.g. "30 days" or "Immediate"

  // ─── Media ───────────────────────────────────────────────────
  avatarUrl     String?           // Profile picture
  coverUrl      String?           // Portfolio header / banner image
  resumeUrl     String?           // Downloadable resume PDF URL

  // ─── Quick Stats ─────────────────────────────────────────────
  experienceYears Int     @default(0)
  projectsCount   Int     @default(0)

  // ─── Work Preferences ────────────────────────────────────────
  workPreferences Json?   // { remote: bool, hybrid: bool, onsite: bool, relocation: bool }
  jobTypes        String[] // ["full-time", "part-time", "contract", "freelance", "internship"]
  preferredRoles  String[] // ["Backend Engineer", "ML Engineer", "DevOps"]
  industries      String[] // ["Fintech", "EdTech", "Open Source"]
  salaryRange     Json?   // { min, max, currency, period: "annual"|"monthly"|"hourly" }

  // ─── Skills ──────────────────────────────────────────────────
  skills        Json?     // { frontend: [{name,level?,icon?}], backend:[], ml:[], devops:[], databases:[], tools:[], other:[] }
  techStack     String[]  // Fast flat list of top technologies shown in hero/cards

  // ─── Status, Highlights & Focus ──────────────────────────────
  currentStatus Json?     // { label, description?, emoji?, show: bool }
  highlights    Json?     // [{ label, value, icon? }] — e.g. "10+ Projects Built"
  focusAreas    String[]  // ["System Design", "Backend", "AI/ML"]
  achievements  Json?     // [{ title, description?, year?, url? }]

  // ─── Personal ────────────────────────────────────────────────
  languages     String[]  // Spoken/written languages e.g. ["English (C2)", "Hindi"]
  hobbies       String[]  // Personal interests

  // ─── Social & Web ────────────────────────────────────────────
  socials       Json?     // [{ platform, url, icon?, handle? }]
  website       String?   // Personal site / portfolio URL

  // ─── Coding Platforms ────────────────────────────────────────
  // Each: { username, url, stats?: { platform-specific stats } }
  github        Json?     // stats: { repos, stars, contributions, followers, following }
  leetcode      Json?     // stats: { solved, totalSolved, ranking, acceptance, streak }
  codeforces    Json?     // stats: { rating, rank, maxRating, maxRank }
  codechef      Json?     // stats: { rating, stars, globalRank, countryRank }
  hackerrank    Json?     // stats: { badges, score, level }
  gfg           Json?     // stats: { score, streak, rank, problemsSolved }
  kaggle        Json?     // stats: { tier, medals: { gold, silver, bronze } }
  otherProfiles Json?     // [{ platform, username, url, stats? }] — catch-all for others

  // ─── Open Source ─────────────────────────────────────────────
  openSource    Json?     // [{ repo, description?, url, stars?, language?, role? }]

  // ─── Publications & Talks ────────────────────────────────────
  publications  Json?     // [{ title, url?, venue?, date?, type: "article"|"talk"|"paper"|"video"|"podcast" }]

  // ─── Education Quick-Reference ───────────────────────────────
  // Mirrors JourneyEntry for fast access without a join
  education     Json?     // [{ institution, degree?, field?, year?, gpa?, url? }]

  // ─── Testimonials ────────────────────────────────────────────
  testimonials  Json?     // [{ name, role?, company?, text, avatarUrl? }]

  // ─── SEO / Meta ──────────────────────────────────────────────
  seoTitle      String?
  seoDesc       String?
  seoKeywords   String[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── Projects ─────────────────────────────────────────────────────

model Project {
  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  content     String?  @db.Text

  techStack   String[]
  tags        String[]

  thumbnail   String?
  images      String[]

  githubUrl   String?
  liveUrl     String?

  status      String   @default("draft") // draft, published, archived, completed
  featured    Boolean  @default(false)
  priority    Int      @default(0)

  stars       Int?
  forks       Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([featured])
  @@index([slug])
}

// ─── Journey Timeline ─────────────────────────────────────────────

model JourneyEntry {
  id          String    @id @default(uuid())
  type        String    // work, education, project, achievement, other
  title       String
  company     String?
  location    String?

  date        String    // Display string e.g. "2023 - Present"
  startDate   DateTime?
  endDate     DateTime?

  description String    @db.Text
  skills      String[]
  url         String?

  order       Int       @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
  @@index([order])
}

// ─── Certifications ───────────────────────────────────────────────

model Certification {
  id             String    @id @default(uuid())
  title          String
  issuer         String
  date           DateTime
  expirationDate DateTime?
  credentialId   String?
  credentialUrl  String?

  skills         String[]
  image          String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([date])
}

// ─── Blog ─────────────────────────────────────────────────────────

model BlogPost {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  summary     String    @db.Text
  content     String    @db.Text
  coverImage  String?

  tags        String[]

  status      String    @default("draft") // draft, published, archived
  featured    Boolean   @default(false)
  publishedAt DateTime?
  readingTime Int?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([slug])
}

// ─── Contact Messages ─────────────────────────────────────────────

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text

  ipAddress String?
  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([isRead])
}
