// Prisma schema for AnuragOS Backend
// Database: NeonDB (Serverless PostgreSQL)

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma-client"
}

datasource db {
  provider  = "postgresql"
}

// Profile Model - Singleton pattern enforced by fixed ID "main"
model Profile {
  id            String  @id @default("main") // Sentinel — enforces single row at DB level

  // Personal Info
  name          String @default("Anurag Basuri")           // Full name
  pronouns      String @default("he/him")            // e.g. "he/him"
  email         String @default("basurianurag@gmail.com")           // Public contact email (shown on portfolio)
  phone         String @default("+91 9876543210")           // Optional public phone number

  // Career & Bio
  header          String?           // Primary title e.g. "Full Stack Developer"
  bio           String? @db.Text  // Casual personal bio for about section

  // Location(Current)
  Currentlocation      String?           // e.g. "Bangalore, Karnataka, India"

  // Location(Original)
  Originallocation     String?           // e.g. "Jamshedpur, Jharkhand, India"

  // Job Seeking & Availability
  openToWork    Boolean @default(true) // Toggle "Open to Work" badge
  availableFrom String?           // e.g. "Immediately" or "June 2025"
  noticePeriod  String?           // e.g. "30 days" or "Immediate"

  // Job Preferences
  workPreferences Json?   // { remote: bool, hybrid: bool, onsite: bool, relocation: bool }
  jobTypes        String[] // ["full-time", "part-time", "contract", "freelance", "internship"]

  // Media & Links
  avatarUrl     String?           // Profile picture
  coverUrl      String?           // Portfolio header / banner image
  resumeUrl     String?           // Downloadable resume PDF URL

  // Quick Stats
  experienceYears Int     @default(0)
  projectsCount   Int     @default(0)

  // Skills
  skills        Json?     // { AI&ML: ["TensorFlow", "PyTorch"], Backend: ["Node.js", "Django"]}

  // Personal
  languages     String[]  // Spoken/written languages e.g. ["English", "Hindi"]

  // Social & Web
  socials       Json?     // [{ platform, url, icon?, handle? }]
  website       String?   // Personal site / portfolio URL

  // Coding Platforms
  github        String?     // stats: { repos, stars, contributions, followers, following }
  leetcode      String?     // stats: { solved, totalSolved, ranking, acceptance, streak }
  codeforces    String?     // stats: { rating, rank, maxRating, maxRank }
  codechef      String?     // stats: { rating, stars, globalRank, countryRank }
  gfg           String?     // stats: { score, streak, rank, problemsSolved }
  kaggle        String?     // stats: { tier, medals: { gold, silver, bronze } }
  otherProfiles String[]    // [{ platform, username, url, stats? }] — catch-all for others

  // SEO / Meta
  seoTitle      String?
  seoDesc       String?
  seoKeywords   String[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Project Model - Represents individual projects in portfolio
model Project {
  id          String   @id @default(uuid())
  slug        String   @unique

  // Core Info
  title       String
  description String   @db.Text
  techStack   String[]

  // Media & Links
  thumbnail   String?
  images      String[]
  githubUrl   String? // Link to GitHub repo
  liveUrl     String? // Link to live demo or deployed site

  status      String   @default("draft") // draft, published, archived, completed
  featured    Boolean  @default(false)

  stars       Int?
  forks       Int?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([featured])
  @@index([slug])
}

// Journey Model - For storing career and life experience entries
model JourneyEntry {
  id          String    @id @default(uuid())
  type        String    // work, education, project, achievement, other
  title       String
  company     String?
  location    String?

  date        String    // Display string e.g. "2023 - Present"
  startDate   DateTime?
  endDate     DateTime?

  description String    @db.Text
  skills      String[]
  url         String?

  order       Int       @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
  @@index([order])
}

// Certification Model - For storing certification information
model Certification {
  id            String    @id @default(uuid())

  title         String
  issuer        String

  description   String?   @db.Text
  credentialId  String?   @unique
  credentialUrl String?

  certificateUrl String?   // Link to certificate image or PDF

  skills        String[]
  
  startDate     DateTime?
  endDate     DateTime?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([issuer])
}

// BlogPost Model - For blog posts or articles on portfolio
model BlogPost {
  id          String    @id @default(uuid())
  slug        String    @unique

  // Core Info
  title       String
  content     String    @db.Text
  tags        String[]

  coverImage  String?
  otherImages String[]
  link        String?   // Link to original post if cross-posted

  status      String    @default("draft") // draft, published, archived
  publishedAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([slug])
}

// Contact Messages - For storing messages sent via contact form on portfolio
model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text

  ipAddress String?
  isRead    Boolean  @default(false)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([isRead])
}
