// Prisma schema for Anurag.dev Backend
// Database: NeonDB (Serverless PostgreSQL)

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Profile Model - Singleton pattern enforced by fixed ID "main"
model Profile {
  id String @id @default("main") // Sentinel — enforces single row at DB level

  // Personal Info
  name     String @default("Anurag Basuri")
  pronouns String @default("he/him")
  email    String @default("basurianurag@gmail.com")
  phone    String @default("+91 9876543210")

  // Career & Bio
  Tagline  String? // Short, catchy tagline for portfolio header
  header String? // One-liner headline for portfolio header
  bio    String? @db.Text // Casual personal bio for about section

  // Location(Current)
  Currentlocation String? // e.g. "Bangalore, Karnataka, India"

  // Location(Original)
  Originallocation String? // e.g. "Jamshedpur, Jharkhand, India"

  // Job Seeking & Availability
  openToWork    Boolean @default(true) // Toggle "Open to Work" badge
  availableFrom String? // e.g. "Immediately" or "June 2025"
  noticePeriod  String? // e.g. "30 days" or "Immediate"

  // Job Preferences
  workPreferences Json? // { remote: bool, hybrid: bool, onsite: bool, relocation: bool }
  Freelancing Boolean @default(false) // Toggle freelance availability

  // Media & Links
  avatarUrl String? // Profile picture
  coverUrl  String? // Portfolio header / banner image
  resumeUrl String? // Downloadable resume PDF URL

  // Quick Stats
  experienceYears Int @default(0)
  projectsCount   Int @default(0)

  // Skills
  skills Json? // { AI&ML: ["TensorFlow", "PyTorch"], Backend: ["Node.js", "Django"]}

  // Personal
  languages String[] // Spoken/written languages e.g. ["English", "Hindi"]

  // Social Links - Stored in a separate table for flexibility and scalability
  socialLinks SocialLink[]

  // Coding Platforms
  github        String?
  leetcode      String?
  codeforces    String? 
  codechef      String?
  gfg           String? 
  kaggle        String?
  hackerrank    String?
  stackoverflow String?
  otherProfiles String[]

  // SEO / Meta
  seoTitle    String?
  seoDesc     String?
  seoKeywords String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Project Model - Represents individual projects in portfolio
model Project {
  id   String @id @default(uuid())

  // Core Info
  title       String
  description String   @db.Text
  techStack   String[]

  // Media & Links
  thumbnail String?
  images    String[] // uploaded images or external URLs
  githubUrl String? // Link to GitHub repo
  liveUrl   String? // Link to live demo or deployed site

  status   String  @default("draft") // draft, published, archived, completed
  order    Int     @default(0)

  stars Int?
  forks Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([order])
}

// Journey Model - Career, education, and life experience entries
model JourneyEntry {
  id           String  @id @default(uuid())

  // Core
  type         JourneyType
  title        String
  organization String? // School, company, lab, NGO — generic label
  location     String?

  date      String // Display string e.g. "2023 - Present"
  startDate DateTime?
  endDate   DateTime?
  isCurrent Boolean   @default(false)

  description String   @db.Text
  skills      String[]
  url         String?

  // Education-specific
  degree       String? // e.g. "B.Tech", "High School", "M.Sc"
  fieldOfStudy String? // e.g. "Computer Science and Engineering"
  grade        String? // e.g. "9.2 CGPA", "85%", "3.8/4.0" — string for flexibility
  board        String? // e.g. "CBSE", "ICSE", "State Board" (school-level)

  // Work-specific
  employmentType EmploymentType?
  workMode       WorkMode?
  workType       WorkType?
  workLocation   String? // Office location or client site
  offerUrl       String? // Offer letter or appointment letter URL
  experienceUrl  String? // Experience/relieving letter URL

  // Research-specific
  publication String? // Journal / conference name
  doi         String? // DOI identifier

  // Display
  icon        String? // Custom icon/logo URL for the organization
  highlighted Boolean @default(false) // Pin important entries

  order Int @default(0)

  // Relations
  achievements Achievement[]
  documents    JourneyDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([order])
}

model JourneyDocument {
  id String @id @default(uuid())

  journeyEntryId String
  journeyEntry   JourneyEntry @relation(fields: [journeyEntryId], references: [id], onDelete: Cascade)

  title String
  type  DocumentType
  url   String // Uploaded file URL or external link

  issuer   String?
  issuedAt DateTime?
  notes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([journeyEntryId])
  @@index([type])
}

enum JourneyType {
  WORK
  EDUCATION
  VOLUNTEERING
  RESEARCH
  EDUCATOR
  OTHER
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  FREELANCE
  TEMPORARY
  APPRENTICESHIP
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum WorkType {
  INDIVIDUAL_CONTRIBUTOR
  LEAD
  MANAGER
  CONSULTANT
  OTHER
}

enum DocumentType {
  OFFER_LETTER
  APPOINTMENT_LETTER
  EXPERIENCE_LETTER
  RELIEVING_LETTER
  PAYSLIP
  PROMOTION_LETTER
  CERTIFICATE
  OTHER
}

// Achievement Model - Hackathons, awards, competitions, scholarships, etc.
model Achievement {
  id String @id @default(uuid())

  title    String // "Won XYZ Hackathon"
  category String // hackathon, competition, award, opensource, publication, scholarship
  issuer   String? // Organization that gave the award
  event    String? // Event / competition name

  description String? @db.Text
  rank        String? // "1st Place", "Top 10", "Gold Medal"

  date     DateTime?
  proofUrl String? // Uploaded certificate or external link as proof of achievement
  url      String? // Related external link

  tags String[] // Skills / topics
  team String[] // Team member names

  featured Boolean @default(false)
  order    Int     @default(0)

  // Optional relation to a Journey entry
  journeyEntryId String?
  journeyEntry   JourneyEntry? @relation(fields: [journeyEntryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([featured])
  @@index([order])
  @@index([journeyEntryId])
}

// Certification Model - For storing certification information
model Certification {
  id String @id @default(uuid())

  title  String
  issuer String

  description   String? @db.Text
  credentialId  String? @unique
  credentialUrl String?

  certificateUrl String? // Uploadable certificate file or external URL

  skills String[]

  startDate DateTime?
  endDate   DateTime?

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([issuer])
  @@index([order])
}

// BlogPost Model - For blog posts or articles on portfolio
model BlogPost {
  id   String @id @default(uuid())

  // Core Info
  title   String
  content String   @db.Text
  tags    String[]

  coverImage  String? // Uploaded image or external URL
  otherImages String[] // Uploaded images or external URLs
  link        String? // Link to original post if cross-posted

  status      String    @default("draft") // draft, published, archived
  publishedAt DateTime?

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([order])
}

// Contact Messages - For storing messages sent via contact form on portfolio
model ContactMessage {
  id      String @id @default(uuid())
  name    String
  email   String
  subject String
  message String @db.Text

  ipAddress String?
  isRead    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([isRead])
}

// SocialLink model (will be used inside profile model to store multiple social links in a separate table)
model SocialLink {
  id String @id @default(uuid())
  platform SocialPlatform
  url      String

  // For custom entries when platform = OTHER
  customLabel String?

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platform])
  @@index([profileId])
}

enum SocialPlatform {
  LINKEDIN
  GITHUB
  X
  REDDIT
  INSTAGRAM
  MEDIUM
  QUORA
  OTHER
}

// AgentSession - Stores the LangChain AI Assistant conversation history permanently
model AgentSession {
  id        String   @id @default(uuid())
  sessionId String   @unique // The unique browser ID from the frontend
  
  // LangChain serialized message array containing BaseMessage instances
  history   Json     @default("[]")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}