// Prisma schema for AnuragOS Backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  username      String         @unique
  passwordHash  String
  email         String         @unique
  isLocked      Boolean        @default(false)
  lockedUntil   DateTime?
  failedAttempts Int           @default(0)
  lastFailedAt  DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  isRevoked Boolean  @default(false)
  
  @@index([userId])
  @@index([token])
}

// Singleton model for user profile/about
model Profile {
  id              String   @id @default(uuid())
  name            String
  role            String
  tagline         String?
  summary         String   @db.Text
  bio             String   @db.Text
  location        String?
  avatarUrl       String?
  resumeUrl       String?
  experienceYears Int      @default(0)
  projectsCount   Int      @default(0)
  
  // Stored as JSON for flexibility
  skills          Json     // { frontend: [], backend: [], ml: [] }
  socials         Json?    // [{ platform: 'github', url: '...' }]
  
  updatedAt       DateTime @updatedAt
}

model CodingStats {
  id              String   @id @default(uuid())
  
  // JSON Blobs for structured sub-objects
  languages       Json     // [{ name, percentage, color }]
  leetcode        Json     // { username, url }
  codeforces      Json     // { username, url }
  github          Json     // { username, url }
  
  updatedAt       DateTime @updatedAt
}

model Project {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  description String    @db.Text
  content     String?   @db.Text
  
  techStack   String[]
  tags        String[]
  
  thumbnail   String?
  images      String[]  // Allow multiple images
  
  githubUrl   String?
  liveUrl     String?
  
  status      String    @default("draft") // draft, published, archived, completed
  featured    Boolean   @default(false)
  priority    Int       @default(0)
  
  stars       Int?
  forks       Int?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  versions    Version[] @relation("ProjectVersions")
  
  @@index([status])
  @@index([featured])
  @@index([slug])
}

model JourneyEntry {
  id          String   @id @default(uuid())
  type        String   // work, education, project, etc.
  title       String   // Role/Degree
  company     String?  // Company/University
  location    String?
  
  date        String   // Display string e.g. "2023 - Present"
  startDate   DateTime?
  endDate     DateTime?
  
  description String   @db.Text
  skills      String[]
  url         String?
  
  order       Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([type])
  @@index([order])
}

model Certification {
  id             String   @id @default(uuid())
  title          String
  issuer         String
  date           DateTime
  expirationDate DateTime?
  credentialId   String?
  credentialUrl  String?
  
  skills         String[]
  image          String?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  @@index([date])
}

model BlogPost {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  summary     String    @db.Text
  content     String    @db.Text
  coverImage  String?
  
  tags        String[]
  
  status      String    @default("draft")
  featured    Boolean   @default(false)
  publishedAt DateTime?
  readingTime Int?      // Estimated minutes
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  versions    Version[] @relation("BlogPostVersions")
  
  @@index([status])
  @@index([slug])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  
  ipAddress String?
  isRead    Boolean  @default(false)
  
  createdAt DateTime @default(now())
  
  @@index([createdAt])
  @@index([isRead])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  action       String
  resourceType String
  resourceId   String
  changes      Json
  timestamp    DateTime @default(now())
  
  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([timestamp])
}

model Version {
  id            String   @id @default(uuid())
  resourceType  String
  resourceId    String
  versionNumber Int
  data          Json
  changeSummary String?
  createdBy     String?
  createdAt     DateTime @default(now())
  
  project       Project?  @relation("ProjectVersions", fields: [projectId], references: [id])
  projectId     String?
  blogPost      BlogPost? @relation("BlogPostVersions", fields: [blogPostId], references: [id])
  blogPostId    String?
  
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

